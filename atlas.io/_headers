# Always revalidate the app shell + service worker so a new deploy shows on the
# next load instead of lingering in the browser/CDN cache (prevents stale "whiteout"
# copies). Static assets (icons, images, SEO pages) keep their default caching.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/atlas.html
  Cache-Control: no-cache
/admin.html
  Cache-Control: no-cache
/atlas-sw.js
  Cache-Control: no-cache
/atlas-manifest.json
  Cache-Control: no-cache
